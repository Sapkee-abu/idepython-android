<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: hamburger + open-file tabs, same row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#21252B"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/menuButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:contentDescription="@string/files_title"
                android:src="@drawable/ic_hamburger" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabIndicatorColor="#61AFEF"
                app:tabTextColor="#7F8792"
                app:tabSelectedTextColor="@android:color/white" />
        </LinearLayout>

        <!-- Find & replace -->
        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2C313A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/findInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/find_hint"
                android:textColorHint="#5C6370"
                android:textColor="@android:color/white"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionNext" />

            <EditText
                android:id="@+id/replaceInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="@string/replace_hint"
                android:textColorHint="#5C6370"
                android:textColor="@android:color/white"
                android:singleLine="true"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/findPrevButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/previous"
                android:src="@android:drawable/arrow_up_float" />

            <ImageButton
                android:id="@+id/findNextButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/next"
                android:src="@android:drawable/arrow_down_float" />

            <Button
                android:id="@+id/replaceButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/replace"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/replaceAllButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/replace_all"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/closeFindButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/close"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- Body: left action rail + editor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left action rail -->
            <LinearLayout
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="#21252B"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageButton
                    android:id="@+id/railRunButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="@string/run"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#98C379" />

                <ImageButton
                    android:id="@+id/railStopButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="@string/stop"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="#E06C75" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="4dp"
                    android:background="#3E4451" />

                <ImageButton
                    android:id="@+id/railConsoleButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="@string/console_title"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="#61AFEF" />

                <ImageButton
                    android:id="@+id/railSaveButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="@string/save"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="#ABB2BF" />

                <ImageButton
                    android:id="@+id/railFindButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="@string/find"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#ABB2BF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/railMoreButton"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:contentDescription="@string/more"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="#ABB2BF" />
            </LinearLayout>

            <!-- Editor column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/syntaxErrorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#4A1F1F"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:textColor="#E06C75"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="⚠ Syntax error บรรทัด 3: invalid syntax" />

                <ScrollView
                    android:id="@+id/editorScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#282C34"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lineNumbers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#21252B"
                            android:fontFamily="monospace"
                            android:gravity="end|top"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="0dp"
                            android:minWidth="32dp"
                            android:paddingHorizontal="8dp"
                            android:paddingTop="12dp"
                            android:textColor="#4B5263"
                            android:textSize="14sp"
                            tools:text="1\n2\n3" />

                        <com.example.idepython.CodeEditText
                            android:id="@+id/codeEditor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="monospace"
                            android:gravity="top|start"
                            android:hint="@string/editor_hint"
                            android:textColorHint="#5C6370"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="0dp"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:padding="12dp"
                            android:textColor="#ABB2BF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </ScrollView>

                <!-- Quick symbol toolbar -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#21252B"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/symbolToolbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- File drawer -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#21252B"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#181A1F"
            android:padding="16dp"
            android:text="@string/files_title"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/newFileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/new_file" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
